FINNHUB_API_KEY=your_finnhub_api_key_here
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DynamoDB persistence (see src/data/db.py). Uses the standard AWS
# credential chain (env vars / ~/.aws/credentials / IAM role) - only the
# region needs to be set explicitly here.
AWS_REGION=us-east-1
DYNAMODB_ENABLED=true
# Only needed to point at DynamoDB Local for testing, e.g. http://localhost:8000
DYNAMODB_ENDPOINT_URL=

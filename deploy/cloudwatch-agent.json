{
    "agent": {
        "run_as_user": "root"
    },
    "logs": {
        "logs_collected": {
            "files": {
                "collect_list": [
                    {
                        "file_path": "/home/ubuntu/ai-trading-platform/logs/trading.log",
                        "log_group_name": "/trading-bot/trading.log",
                        "log_stream_name": "{instance_id}",
                        "timezone": "UTC",
                        "retention_in_days": 90
                    }
                ]
            }
        }
    }
}

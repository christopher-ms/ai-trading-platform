{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "TradingBotLogsRead",
            "Effect": "Allow",
            "Action": [
                "logs:GetLogEvents",
                "logs:FilterLogEvents",
                "logs:DescribeLogStreams"
            ],
            "Resource": [
                "arn:aws:logs:*:*:log-group:/trading-bot/*",
                "arn:aws:logs:*:*:log-group:/trading-bot/*:log-stream:*"
            ]
        },
        {
            "Sid": "TradingBotLogsListGroups",
            "Effect": "Allow",
            "Action": [
                "logs:DescribeLogGroups"
            ],
            "Resource": [
                "arn:aws:logs:*:*:log-group:*"
            ]
        }
    ]
}
